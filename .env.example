# Optional. Every setting has a value in nuxt.config.ts (runtimeConfig); set one of these, in .env
# or the container's environment, only to point this environment somewhere else.

# NUXT_API_BASE=https://your-api-host/v1

# Firebase web config for phone sign-in on the website.
# NUXT_PUBLIC_FIREBASE_API_KEY=
# NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=
# NUXT_PUBLIC_FIREBASE_APP_ID=
